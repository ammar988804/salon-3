NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# WhatsApp Cloud API — OPTIONAL.
# Leave these blank and messaging still works: the app composes, personalises
# and logs every message, then hands each one to WhatsApp via a click-to-chat
# link. Fill them in and the same screens send directly from the server, with
# delivery receipts and customer replies landing back in the app.
# From Meta Business > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you invent; paste the same one into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret — used to verify that inbound webhooks really came from Meta.
WHATSAPP_APP_SECRET=
